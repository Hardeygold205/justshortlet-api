{
  "name": "server",
  "version": "1.0.0",
  "main": "index.js",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "cross-env NODE_ENV=development nodemon src/index.js",
    "start": "cross-env NODE_ENV=production node src/index.js",
    "build": "tsc",
    "migrate:create": "node-pg-migrate create --migrations-dir migrations",
    "migrate:up:local": "dotenv -e .env.local -- node-pg-migrate up --migrations-dir migrations",
    "migrate:down:local": "dotenv -e .env.local -- node-pg-migrate down --migrations-dir migrations",
    "migrate:up:production": "dotenv -e .env -- node-pg-migrate up --migrations-dir migrations",
    "migrate:down:production": "dotenv -e .env -- node-pg-migrate down --migrations-dir migrations",
    "drizzle:generate": "drizzle-kit generate",
    "drizzle:migrate": "drizzle-kit migrate",
    "drizzle:studio": "drizzle-kit studio",
    "drizzle:push": "drizzle-kit push",
    "prisma:migrate": "prisma migrate dev",
    "prisma:generate": "prisma generate",
    "prisma:studio": "prisma studio",
    "prisma:reset": "prisma migrate reset"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.6.0",
    "@supabase/supabase-js": "^2.101.0",
    "bcrypt": "^6.0.0",
    "cloudinary": "^2.9.0",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.1",
    "helmet": "^8.1.0",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.1.1",
    "mysql2": "^3.23.3",
    "node-pg-migrate": "^8.0.4",
    "nodemon": "^3.1.14",
    "passport": "^0.7.0",
    "pg": "^8.23.0",
    "postgres": "^3.4.8",
    "prisma": "^7.6.0",
    "redis": "^5.11.0",
    "sharp": "^0.35.3",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "cross-env": "^10.1.0",
    "dotenv-cli": "^11.0.0"
  }
}
