{
  "name": "justshortlet-backend",
  "version": "1.0.0",
  "main": "index.js",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "cross-env NODE_ENV=development nodemon src/index.js",
    "start": "cross-env NODE_ENV=production node src/index.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "dotenv -e .env.local -- prisma migrate dev",
    "prisma:migrate:name": "dotenv -e .env.local -- prisma migrate dev --name",
    "prisma:migrate:deploy": "dotenv -e .env -- prisma migrate deploy",
    "prisma:migrate:status": "dotenv -e .env.local -- prisma migrate status",
    "prisma:migrate:resolve": "dotenv -e .env.local -- prisma migrate resolve",
    "prisma:push": "dotenv -e .env.local -- prisma db push",
    "prisma:pull": "dotenv -e .env.local -- prisma db pull",
    "prisma:studio": "dotenv -e .env.local -- prisma studio",
    "prisma:reset": "dotenv -e .env.local -- prisma migrate reset",
    "prisma:seed": "dotenv -e .env.local -- prisma db seed",
    "prisma:seed:admin": "dotenv -e .env -- node prisma/seed-superadmin.js",
    "prisma:seed:amenities": "dotenv -e .env -- node prisma/seed-amenities.js",
    "prisma:format": "prisma format",
    "prisma:validate": "prisma validate"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "axios": "^1.19.0",
    "bcrypt": "^6.0.0",
    "cloudinary": "^2.9.0",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.1",
    "google-auth-library": "^11.0.2",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "jwks-rsa": "^4.1.0",
    "multer": "^2.1.1",
    "nodemailer": "^10.0.11",
    "nodemon": "^3.1.14",
    "passport": "^0.7.0",
    "pg": "^8.23.0",
    "postgres": "^3.4.8",
    "prisma": "^7.9.1",
    "redis": "^5.11.0",
    "sharp": "^0.35.3",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "cross-env": "^10.1.0",
    "dotenv-cli": "^11.0.0"
  }
}
